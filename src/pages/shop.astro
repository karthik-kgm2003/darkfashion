---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL;
const allProducts = await getCollection('products');

// Sort featured first, then by name
const products = allProducts.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.name.localeCompare(b.data.name);
});

const categories = ['All', ...new Set(products.map(p => p.data.category))];

const totalInStock    = products.filter(p => p.data.inStock).length;
const totalOutOfStock = products.filter(p => !p.data.inStock).length;

function formatPrice(price: number) {
  return new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
    maximumFractionDigits: 0,
  }).format(price);
}

// Price range for the slider
const prices   = products.map(p => p.data.price);
const minPrice = Math.min(...prices);
const maxPrice = Math.max(...prices);
---

<MainLayout
  title="Shop — DARK Fashion & Trends | Padinjarangadi, Kerala"
  description={`Browse all ${products.length} items at DARK Fashion & Trends. Clothing, accessories and footwear for men and women in Padinjarangadi, Kerala.`}
>

  <!-- ── PAGE HEADER ────────────────────────────────────────────── -->
  <section class="relative bg-[#080808] border-b border-[var(--color-border)] py-14 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 80px 80px;">
    </div>
    <div class="absolute right-0 top-0 h-full w-1/2 bg-gradient-to-l from-[var(--color-accent)]/10 to-transparent pointer-events-none"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-barlow-condensed font-semibold tracking-widest uppercase text-zinc-600 mb-6">
        <a href={`${base}/`} class="hover:text-[var(--color-accent)] transition-colors">Home</a>
        <span>›</span>
        <span class="text-zinc-400">Shop</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h1 class="font-bebas text-6xl sm:text-7xl text-[var(--color-text-main)] tracking-wide leading-none mb-2">All Products</h1>
          <p class="text-sm text-[var(--color-text-muted)] font-barlow">
            <span class="text-[var(--color-text-main)] font-semibold">{products.length}</span> items &nbsp;·&nbsp;
            <span class="text-green-400">{totalInStock} in stock</span>
            {totalOutOfStock > 0 && (
              <span> &nbsp;·&nbsp; <span class="text-zinc-600">{totalOutOfStock} out of stock</span></span>
            )}
          </p>
        </div>
        <!-- View toggle -->
        <div class="flex items-center gap-2 shrink-0">
          <button id="grid-view-btn"
            aria-label="Grid view"
            class="view-btn active-view flex items-center justify-center h-9 w-9 border border-[var(--color-accent)] bg-[var(--color-accent)]/10 text-[var(--color-accent)] transition-all duration-200">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"/>
            </svg>
          </button>
          <button id="list-view-btn"
            aria-label="List view"
            class="view-btn flex items-center justify-center h-9 w-9 border border-zinc-700 text-zinc-500 hover:border-zinc-400 hover:text-[var(--color-text-main)] transition-all duration-200">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── MAIN LAYOUT ────────────────────────────────────────────── -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col lg:flex-row gap-10">

      <!-- ── SIDEBAR FILTERS ──────────────────────────────────── -->
      <aside class="lg:w-64 shrink-0">

        <!-- Mobile filter toggle -->
        <button id="filter-toggle"
          class="lg:hidden w-full flex items-center justify-between bg-[var(--color-surface)] border border-[var(--color-border)] px-5 py-3.5 text-sm font-barlow-condensed font-semibold tracking-[0.15em] uppercase text-[var(--color-text-main)] mb-4">
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
            </svg>
            Filters
          </span>
          <svg id="filter-chevron" class="h-4 w-4 text-zinc-500 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
          </svg>
        </button>

        <div id="filter-panel" class="hidden lg:block space-y-8">

          <!-- Category filter -->
          <div>
            <h3 class="font-bebas text-lg text-[var(--color-text-main)] tracking-widest mb-4 flex items-center gap-2">
              Category
              <span class="h-px flex-1 bg-white/5"></span>
            </h3>
            <ul class="space-y-1" id="category-list">
              {categories.map((cat, i) => {
                const count = cat === 'All'
                  ? products.length
                  : products.filter(p => p.data.category === cat).length;
                return (
                  <li>
                    <button
                      class:list={[
                        'category-filter w-full flex items-center justify-between px-3 py-2.5 text-sm font-barlow transition-all duration-200',
                        i === 0
                          ? 'bg-[var(--color-accent)]/10 border-l-2 border-[var(--color-accent)] text-[var(--color-text-main)] font-semibold'
                          : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] hover:bg-white/5 border-l-2 border-transparent',
                      ]}
                      data-filter={cat === 'All' ? 'all' : cat}
                    >
                      <span>{cat}</span>
                      <span class:list={[
                        'font-barlow-condensed text-xs tracking-wider',
                        i === 0 ? 'text-[var(--color-accent)]' : 'text-zinc-700',
                      ]}>{count}</span>
                    </button>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Price range -->
          <div>
            <h3 class="font-bebas text-lg text-[var(--color-text-main)] tracking-widest mb-4 flex items-center gap-2">
              Price Range
              <span class="h-px flex-1 bg-white/5"></span>
            </h3>
            <div class="px-1">
              <input
                id="price-range"
                type="range"
                min={minPrice}
                max={maxPrice}
                value={maxPrice}
                step="100"
                class="w-full h-1 bg-zinc-800 rounded-none appearance-none cursor-pointer accent-[var(--color-accent)]"
              />
              <div class="flex justify-between mt-2 text-xs font-barlow-condensed text-zinc-500">
                <span>{formatPrice(minPrice)}</span>
                <span id="price-display" class="text-[var(--color-text-main)] font-semibold">{formatPrice(maxPrice)}</span>
              </div>
            </div>
          </div>

          <!-- Availability -->
          <div>
            <h3 class="font-bebas text-lg text-[var(--color-text-main)] tracking-widest mb-4 flex items-center gap-2">
              Availability
              <span class="h-px flex-1 bg-white/5"></span>
            </h3>
            <div class="space-y-2">
              {[
                { id: 'avail-all',      label: 'All Items',     value: 'all',      count: products.length        },
                { id: 'avail-instock',  label: 'In Stock',      value: 'instock',  count: totalInStock           },
                { id: 'avail-outstock', label: 'Out of Stock',  value: 'outstock', count: totalOutOfStock        },
              ].map(({ id, label, value, count }) => (
                <label class="flex items-center gap-3 cursor-pointer group">
                  <input
                    type="radio"
                    name="availability"
                    value={value}
                    checked={value === 'all'}
                    class="availability-radio w-4 h-4 accent-[var(--color-accent)] cursor-pointer"
                  />
                  <span class="text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-text-main)] transition-colors flex-1">{label}</span>
                  <span class="text-xs font-barlow-condensed text-zinc-700">{count}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Sort (sidebar on desktop) -->
          <div>
            <h3 class="font-bebas text-lg text-[var(--color-text-main)] tracking-widest mb-4 flex items-center gap-2">
              Sort By
              <span class="h-px flex-1 bg-white/5"></span>
            </h3>
            <div class="space-y-1" id="sort-list">
              {[
                { label: 'Featured',       value: 'featured'    },
                { label: 'Name: A → Z',    value: 'name-asc'    },
                { label: 'Name: Z → A',    value: 'name-desc'   },
                { label: 'Price: Low → High', value: 'price-asc' },
                { label: 'Price: High → Low', value: 'price-desc'},
              ].map(({ label, value }, i) => (
                <button
                  class:list={[
                    'sort-btn w-full text-left px-3 py-2 text-sm font-barlow transition-all duration-200',
                    i === 0
                      ? 'text-[var(--color-text-main)] font-semibold bg-white/5'
                      : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] hover:bg-white/5',
                  ]}
                  data-sort={value}
                >
                  {label}
                </button>
              ))}
            </div>
          </div>

          <!-- Clear filters -->
          <button
            id="clear-filters"
            class="w-full border border-zinc-800 text-zinc-600 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] text-xs font-barlow-condensed font-semibold tracking-[0.2em] uppercase py-3 transition-all duration-200"
          >
            Clear All Filters
          </button>

        </div>
      </aside>

      <!-- ── PRODUCT GRID ─────────────────────────────────────── -->
      <div class="flex-1 min-w-0">

        <!-- Active filters + result count bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-5 border-b border-[var(--color-border)]">
          <div id="result-count" class="font-barlow text-sm text-[var(--color-text-muted)]">
            Showing <span id="count-display" class="text-[var(--color-text-main)] font-semibold">{products.length}</span> products
          </div>
          <div id="active-filters" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- Grid -->
        <div
          id="product-grid"
          class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5"
        >
          {products.map((product) => {
            const { name, price, category, image, inStock, featured } = product.data;
            const href = `${base}/products/${product.id}`;
            return (
              <article
                class="product-card group relative bg-[var(--color-surface)] border border-[var(--color-border)] overflow-hidden hover:border-[var(--color-accent)]/30 transition-all duration-500"
                data-category={category}
                data-price={price}
                data-name={name}
                data-instock={inStock ? 'true' : 'false'}
                data-featured={featured ? 'true' : 'false'}
              >
                <!-- Image -->
                <a href={href} class="block relative aspect-[3/4] overflow-hidden bg-zinc-900">
                  <img
                    src={image}
                    alt={name}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  <!-- Gradient overlay -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-400"></div>

                  <!-- Badges -->
                  <div class="absolute top-2.5 left-2.5 flex flex-col gap-1.5">
                    {featured && (
                      <span class="bg-[var(--color-accent)] text-[#050505] text-[9px] font-barlow-condensed font-bold tracking-[0.15em] uppercase px-2 py-1 leading-none">
                        Featured
                      </span>
                    )}
                    {!inStock && (
                      <span class="bg-[#050505]/80 text-[var(--color-text-muted)] text-[9px] font-barlow-condensed font-semibold tracking-[0.15em] uppercase px-2 py-1 leading-none border border-[var(--color-border)]">
                        Sold Out
                      </span>
                    )}
                  </div>

                  <!-- Quick view on hover -->
                  <div class="absolute bottom-0 left-0 right-0 translate-y-full group-hover:translate-y-0 transition-transform duration-300 p-2.5">
                    <a href={href}
                      class="w-full flex items-center justify-center gap-1.5 bg-[var(--color-accent)] hover:bg-[var(--color-accent-dim)] text-[#050505] font-barlow-condensed font-bold tracking-[0.12em] uppercase text-[11px] py-2.5 transition-colors duration-200">
                      View Product
                      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </a>
                  </div>
                </a>

                <!-- Info -->
                <div class="p-3">
                  <p class="text-[10px] text-zinc-600 font-barlow-condensed tracking-widest uppercase mb-1">{category}</p>
                  <a href={href}>
                    <h2 class="font-barlow font-semibold text-xs sm:text-sm text-zinc-200 group-hover:text-[var(--color-accent)] transition-colors duration-200 line-clamp-2 leading-snug mb-2">
                      {name}
                    </h2>
                  </a>
                  <div class="flex items-center justify-between">
                    <span class="font-bebas text-lg text-[var(--color-text-main)] tracking-wider">{formatPrice(price)}</span>
                    <span class:list={[
                      'text-[9px] font-barlow-condensed font-semibold tracking-wider uppercase',
                      inStock ? 'text-green-500' : 'text-zinc-600',
                    ]}>
                      {inStock ? '● In Stock' : '○ Sold Out'}
                    </span>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <!-- List view (hidden by default) -->
        <div id="product-list" class="hidden divide-y divide-[var(--color-border)]">
          {products.map((product) => {
            const { name, price, category, image, inStock, description, featured } = product.data;
            const href = `${base}/products/${product.id}`;
            return (
              <article
                class="product-card-list flex gap-4 sm:gap-6 py-5 group"
                data-category={category}
                data-price={price}
                data-name={name}
                data-instock={inStock ? 'true' : 'false'}
                data-featured={featured ? 'true' : 'false'}
              >
                <a href={href} class="shrink-0 relative w-24 h-32 sm:w-32 sm:h-44 bg-zinc-900 overflow-hidden">
                  <img
                    src={image}
                    alt={name}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  {!inStock && (
                    <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                      <span class="text-[9px] text-[var(--color-text-muted)] font-barlow-condensed tracking-widest uppercase">Sold Out</span>
                    </div>
                  )}
                </a>
                <div class="flex flex-col justify-between py-1 min-w-0">
                  <div>
                    <p class="text-[10px] text-zinc-600 font-barlow-condensed tracking-widest uppercase mb-1">{category}</p>
                    <a href={href}>
                      <h2 class="font-barlow font-semibold text-sm sm:text-base text-zinc-200 group-hover:text-[var(--color-accent)] transition-colors leading-snug mb-2">{name}</h2>
                    </a>
                    <p class="text-xs text-[var(--color-text-muted)] leading-relaxed line-clamp-2 hidden sm:block">{description}</p>
                  </div>
                  <div class="flex items-center gap-4 mt-3">
                    <span class="font-bebas text-xl text-[var(--color-text-main)] tracking-wider">{formatPrice(price)}</span>
                    <span class:list={[
                      'text-[10px] font-barlow-condensed font-semibold tracking-wider uppercase',
                      inStock ? 'text-green-400' : 'text-zinc-600',
                    ]}>
                      {inStock ? '● In Stock' : '○ Sold Out'}
                    </span>
                    <a href={href}
                      class="ml-auto hidden sm:inline-flex items-center gap-1.5 border border-zinc-700 hover:border-[var(--color-accent)] text-zinc-500 hover:text-[var(--color-accent)] font-barlow-condensed text-xs font-semibold tracking-[0.15em] uppercase px-4 py-2 transition-all duration-200">
                      View
                      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Empty state -->
        <div id="empty-state" class="hidden py-28 text-center">
          <svg class="h-16 w-16 text-zinc-800 mx-auto mb-6" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 15.803a7.5 7.5 0 0 0 10.607 0Z"/>
          </svg>
          <p class="font-bebas text-4xl text-[var(--color-text-muted)] tracking-wide mb-2">No Products Found</p>
          <p class="text-sm text-zinc-600 mb-6">Try adjusting your filters or clearing them.</p>
          <button id="empty-clear-btn"
            class="inline-flex items-center gap-2 bg-[var(--color-accent)] hover:bg-[var(--color-accent-dim)] text-[#050505] font-barlow-condensed font-bold tracking-[0.2em] uppercase text-sm px-6 py-3 transition-all duration-200">
            Clear Filters
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- ── WHATSAPP STRIP ─────────────────────────────────────────── -->
  <div class="border-t border-[var(--color-border)] bg-[var(--color-surface)] py-10 mt-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <p class="font-bebas text-2xl text-[var(--color-text-main)] tracking-wide">Can't find what you're looking for?</p>
        <p class="text-sm text-[var(--color-text-muted)] mt-1">Message us on WhatsApp — we may have it in store even if it's not listed here.</p>
      </div>
      <a
        href="https://wa.me/91XXXXXXXXXXX?text=Hi%20DARK%20Fashion%2C%20I%27m%20looking%20for%20something%20specific."
        target="_blank"
        rel="noreferrer"
        class="shrink-0 inline-flex items-center gap-3 bg-green-700 hover:bg-green-600 text-white font-barlow-condensed font-semibold tracking-[0.15em] uppercase text-sm px-7 py-3.5 transition-all duration-300"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Ask on WhatsApp
      </a>
    </div>
  </div>

</MainLayout>

<!-- ── CLIENT SCRIPT ────────────────────────────────────────────── -->
<script>
  // ── State
  let activeCategory   = 'all';
  let activeSort       = 'featured';
  let activeAvail      = 'all';
  let activePriceMax   = Infinity;

  // ── Element refs
  const gridEl        = document.getElementById('product-grid')!;
  const listEl        = document.getElementById('product-list')!;
  const emptyEl       = document.getElementById('empty-state')!;
  const countEl       = document.getElementById('count-display')!;
  const activeFiltersEl = document.getElementById('active-filters')!;
  const priceRange    = document.getElementById('price-range') as HTMLInputElement;
  const priceDisplay  = document.getElementById('price-display')!;

  const gridCards     = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
  const listCards     = Array.from(document.querySelectorAll<HTMLElement>('.product-card-list'));

  // ── Helpers
  function formatINR(n: number) {
    return new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(n);
  }

  function getCardData(card: HTMLElement) {
    return {
      category: card.dataset.category ?? '',
      price:    parseFloat(card.dataset.price ?? '0'),
      name:     card.dataset.name ?? '',
      inStock:  card.dataset.instock === 'true',
      featured: card.dataset.featured === 'true',
    };
  }

  function cardVisible(card: HTMLElement) {
    const d = getCardData(card);
    const catOk    = activeCategory === 'all' || d.category === activeCategory;
    const priceOk  = d.price <= activePriceMax;
    const availOk  = activeAvail === 'all'
      ? true
      : activeAvail === 'instock' ? d.inStock : !d.inStock;
    return catOk && priceOk && availOk;
  }

  function sortCards(cards: HTMLElement[]) {
    return [...cards].sort((a, b) => {
      const da = getCardData(a), db = getCardData(b);
      if (activeSort === 'name-asc')   return da.name.localeCompare(db.name);
      if (activeSort === 'name-desc')  return db.name.localeCompare(da.name);
      if (activeSort === 'price-asc')  return da.price - db.price;
      if (activeSort === 'price-desc') return db.price - da.price;
      // featured: featured first
      if (da.featured && !db.featured) return -1;
      if (!da.featured && db.featured) return  1;
      return da.name.localeCompare(db.name);
    });
  }

  function applyFilters() {
    const isGrid = !gridEl.classList.contains('hidden');

    // Sort + filter grid cards
    const sortedGrid = sortCards(gridCards);
    gridEl.innerHTML = '';
    let visible = 0;
    sortedGrid.forEach(card => {
      const show = cardVisible(card);
      if (show) { visible++; card.style.display = ''; } else { card.style.display = 'none'; }
      gridEl.appendChild(card);
    });

    // Sort + filter list cards
    const sortedList = sortCards(listCards);
    listEl.innerHTML = '';
    sortedList.forEach(card => {
      card.style.display = cardVisible(card) ? '' : 'none';
      listEl.appendChild(card);
    });

    // Show / hide empty state
    emptyEl.classList.toggle('hidden', visible > 0);
    countEl.textContent = String(visible);

    // Active filter chips
    renderFilterChips();
  }

  function renderFilterChips() {
    activeFiltersEl.innerHTML = '';
    const chips: { label: string; clear: () => void }[] = [];

    if (activeCategory !== 'all') {
      chips.push({ label: activeCategory, clear: () => { activeCategory = 'all'; setActiveCategory('all'); applyFilters(); } });
    }
    if (activeAvail !== 'all') {
      chips.push({ label: activeAvail === 'instock' ? 'In Stock' : 'Out of Stock', clear: () => {
        activeAvail = 'all';
        (document.querySelector('.availability-radio[value="all"]') as HTMLInputElement).checked = true;
        applyFilters();
      }});
    }
    if (activePriceMax < Infinity) {
      chips.push({ label: `Up to ${formatINR(activePriceMax)}`, clear: () => {
        activePriceMax = Infinity;
        priceRange.value = priceRange.max;
        priceDisplay.textContent = formatINR(parseInt(priceRange.max));
        applyFilters();
      }});
    }

    chips.forEach(({ label, clear }) => {
      const chip = document.createElement('button');
      chip.className = 'flex items-center gap-1.5 bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/30 text-[var(--color-accent)] text-[11px] font-barlow-condensed font-semibold tracking-wider uppercase px-2.5 py-1.5 hover:bg-[var(--color-accent)]/20 transition-colors';
      chip.innerHTML = `${label} <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>`;
      chip.addEventListener('click', clear);
      activeFiltersEl.appendChild(chip);
    });
  }

  function setActiveCategory(val: string) {
    document.querySelectorAll<HTMLButtonElement>('.category-filter').forEach(btn => {
      const isActive = btn.dataset.filter === val;
      btn.classList.toggle('bg-[var(--color-accent)]/10', isActive);
      btn.classList.toggle('border-l-2', true);
      btn.classList.toggle('border-[var(--color-accent)]', isActive);
      btn.classList.toggle('border-transparent', !isActive);
      btn.classList.toggle('text-[var(--color-text-main)]', isActive);
      btn.classList.toggle('font-semibold', isActive);
      btn.classList.toggle('text-[var(--color-text-muted)]', !isActive);
    });
  }

  function clearAll() {
    activeCategory = 'all';
    activeSort     = 'featured';
    activeAvail    = 'all';
    activePriceMax = Infinity;
    setActiveCategory('all');
    document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((b, i) => {
      b.classList.toggle('text-[var(--color-text-main)]', i === 0);
      b.classList.toggle('font-semibold', i === 0);
      b.classList.toggle('bg-white/5', i === 0);
      b.classList.toggle('text-[var(--color-text-muted)]', i !== 0);
    });
    (document.querySelector('.availability-radio[value="all"]') as HTMLInputElement).checked = true;
    priceRange.value = priceRange.max;
    priceDisplay.textContent = formatINR(parseInt(priceRange.max));
    applyFilters();
  }

  // ── Bindings: Category
  document.querySelectorAll<HTMLButtonElement>('.category-filter').forEach(btn => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.filter ?? 'all';
      setActiveCategory(activeCategory);
      applyFilters();
    });
  });

  // ── Bindings: Sort
  document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeSort = btn.dataset.sort ?? 'featured';
      document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach(b => {
        b.classList.toggle('text-[var(--color-text-main)]', b === btn);
        b.classList.toggle('font-semibold', b === btn);
        b.classList.toggle('bg-white/5', b === btn);
        b.classList.toggle('text-[var(--color-text-muted)]', b !== btn);
      });
      applyFilters();
    });
  });

  // ── Bindings: Availability
  document.querySelectorAll<HTMLInputElement>('.availability-radio').forEach(radio => {
    radio.addEventListener('change', () => {
      activeAvail = radio.value;
      applyFilters();
    });
  });

  // ── Bindings: Price range
  priceRange?.addEventListener('input', () => {
    activePriceMax = parseInt(priceRange.value);
    priceDisplay.textContent = formatINR(activePriceMax);
    applyFilters();
  });

  // ── Bindings: Clear filters
  document.getElementById('clear-filters')?.addEventListener('click', clearAll);
  document.getElementById('empty-clear-btn')?.addEventListener('click', clearAll);

  // ── Bindings: Grid / List toggle
  const gridBtn = document.getElementById('grid-view-btn')!;
  const listBtn = document.getElementById('list-view-btn')!;

  gridBtn.addEventListener('click', () => {
    gridEl.classList.remove('hidden');
    listEl.classList.add('hidden');
    gridBtn.classList.add('border-[var(--color-accent)]', 'bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
    gridBtn.classList.remove('border-zinc-700', 'text-zinc-500');
    listBtn.classList.remove('border-[var(--color-accent)]', 'bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
    listBtn.classList.add('border-zinc-700', 'text-zinc-500');
  });

  listBtn.addEventListener('click', () => {
    listEl.classList.remove('hidden');
    gridEl.classList.add('hidden');
    listBtn.classList.add('border-[var(--color-accent)]', 'bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
    listBtn.classList.remove('border-zinc-700', 'text-zinc-500');
    gridBtn.classList.remove('border-[var(--color-accent)]', 'bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
    gridBtn.classList.add('border-zinc-700', 'text-zinc-500');
  });

  // ── Mobile filter toggle
  const filterToggle = document.getElementById('filter-toggle');
  const filterPanel  = document.getElementById('filter-panel');
  const filterChevron = document.getElementById('filter-chevron');
  filterToggle?.addEventListener('click', () => {
    const open = !filterPanel!.classList.contains('hidden');
    filterPanel!.classList.toggle('hidden', open);
    filterChevron!.style.transform = open ? '' : 'rotate(180deg)';
  });
</script>

