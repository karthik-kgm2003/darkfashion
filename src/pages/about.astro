---
import MainLayout from '../layouts/MainLayout.astro';
const base = import.meta.env.BASE_URL;

const values = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>`,
    title: 'Rooted in Padinjarangadi',
    desc:  'We are a local shop, proud of where we come from. We know our customers by name and our community by heart. Shopping here is not a transaction — it is a conversation.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/>`,
    title: 'Hand-picked Selection',
    desc:  'Every item on our floor is chosen carefully. We source trending styles, quality fabrics, and pieces that actually fit Kerala\'s climate and culture — not just whatever is cheap to stock.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"/>`,
    title: 'Fair Prices',
    desc:  'We keep our pricing honest. No inflated MRP games, no fake discounts. What you see is what you pay — and we always have something for every budget in the store.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/>`,
    title: 'Personal Service',
    desc:  'Walk in and we will help you find something that actually fits and suits you. No pushy selling. If we do not have what you need, we will tell you honestly.',
  },
];
---

<MainLayout
  title="About DARK Fashion & Trends — Fashion & Clothing Store, Padinjarangadi"
  description="DARK Fashion & Trends is a fashion and clothing retail store in Padinjarangadi, Kerala. We stock a wide range of trendy clothing, accessories, and more at fair prices."
>

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="relative min-h-[55vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 bg-[var(--color-bg)]"></div>
    <div class="absolute -bottom-32 -right-32 h-[500px] w-[500px] rounded-full bg-[var(--color-accent)]/10 blur-[120px] pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 80px 80px;">
    </div>
    <div class="relative z-10 mx-auto max-w-7xl w-full px-4 sm:px-6 lg:px-8 py-24">
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-12 bg-[var(--color-accent)]"></span>
        <span class="font-barlow-condensed text-xs font-semibold tracking-[0.3em] text-[var(--color-accent)] uppercase">Padinjarangadi, Kerala</span>
      </div>
      <h1 class="font-bebas text-[clamp(3.5rem,11vw,9rem)] leading-[0.88] tracking-wide text-[var(--color-text-main)] mb-6">
        YOUR LOCAL<br/>
        <span class="text-[var(--color-accent)]">FASHION</span><br/>
        <span class="text-stroke-gold">STORE.</span>
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] font-barlow font-light leading-relaxed max-w-xl">
        DARK Fashion & Trends is a clothing and fashion retail store based in Padinjarangadi, Malappuram.
        We stock a carefully chosen range of trendy clothing, accessories, and styles — all under one roof, at prices that make sense.
      </p>
    </div>
  </section>

  <!-- ── INTRO SPLIT ────────────────────────────────────────────── -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Image -->
      <div class="relative">
        <div class="aspect-[4/5] bg-zinc-900 overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?w=800&q=80"
            alt="Inside DARK Fashion & Trends store"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="absolute -bottom-6 -right-6 bg-[var(--color-accent)] px-8 py-6 hidden sm:block">
          <span class="font-bebas text-5xl text-[#050505] block leading-none">500+</span>
          <span class="font-barlow-condensed text-xs text-[#050505] tracking-[0.2em] font-semibold uppercase">Happy Customers</span>
        </div>
        <div class="absolute -top-4 -left-4 h-32 w-32 border border-[var(--color-accent)]/30 pointer-events-none"></div>
      </div>

      <!-- Text -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="h-px w-8 bg-[var(--color-accent)]"></span>
          <span class="font-barlow-condensed text-xs font-semibold tracking-[0.3em] text-[var(--color-accent)] uppercase">Who We Are</span>
        </div>
        <h2 class="font-bebas text-5xl text-[var(--color-text-main)] tracking-wide mb-6">
          Fashion You Can Actually Find in Padinjarangadi
        </h2>
        <div class="space-y-4 text-[var(--color-text-muted)] font-barlow text-sm leading-relaxed">
          <p>
            DARK Fashion & Trends is a retail clothing store in the heart of Padinjarangadi.
            We opened our doors to give the local community a proper destination for fashion —
            a place where you can walk in, browse a real selection, and leave with something you genuinely like.
          </p>
          <p>
            We stock a wide range of clothing and accessories for men and women — from casual everyday wear
            to occasion outfits. Our team stays on top of current trends so the store is always fresh,
            and we update our stock regularly so there is always something new to discover.
          </p>
          <p>
            We also take orders through WhatsApp, so if you have seen something specific or want help
            putting together an outfit, just reach out. We are happy to help.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap gap-8">
          {[['500+','Happy Customers'], ['Wide','Selection'], ['Local','& Trusted']].map(([val, label]) => (
            <div>
              <span class="font-bebas text-4xl text-[var(--color-text-main)] block tracking-wider">{val}</span>
              <span class="font-barlow-condensed text-xs text-[var(--color-text-muted)] tracking-[0.2em] uppercase">{label}</span>
            </div>
          ))}
        </div>

        <div class="mt-10 flex gap-4">
          <a
            href={`${base}/shop`}
            class="inline-flex items-center gap-2 bg-[var(--color-accent)] hover:bg-[var(--color-accent-dim)] text-[#050505] font-barlow-condensed font-bold tracking-[0.15em] uppercase text-sm px-7 py-3.5 transition-all duration-300 hover:shadow-[0_8px_30px_rgba(212,175,55,0.35)]"
          >
            Browse the Store
          </a>
          <a
            href={`${base}/contact`}
            class="inline-flex items-center gap-2 border border-[var(--color-border)] hover:border-[var(--color-accent)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] font-barlow-condensed font-semibold tracking-[0.15em] uppercase text-sm px-7 py-3.5 transition-all duration-300"
          >
            Find Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── VALUES ─────────────────────────────────────────────────── -->
  <section class="border-t border-b border-[var(--color-border)] bg-[var(--color-bg)] py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="font-barlow-condensed text-xs font-semibold tracking-[0.3em] text-[var(--color-accent)] uppercase mb-3">Why Shop With Us</p>
        <h2 class="font-bebas text-5xl sm:text-6xl text-[var(--color-text-main)] tracking-wide">What We Stand For</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map(({ icon, title, desc }) => (
          <div class="group bg-[var(--color-surface)] border border-[var(--color-border)] p-8 hover:border-[var(--color-accent)]/30 transition-all duration-500">
            <div class="flex items-center justify-center h-12 w-12 bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/20 text-[var(--color-accent)] mb-6 group-hover:bg-[var(--color-accent)] group-hover:text-[#050505] transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={icon}></svg>
            </div>
            <h3 class="font-bebas text-2xl text-[var(--color-text-main)] tracking-wide mb-3">{title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WHAT WE STOCK ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center mb-14">
      <p class="font-barlow-condensed text-xs font-semibold tracking-[0.3em] text-[var(--color-accent)] uppercase mb-3">In Store & Online</p>
      <h2 class="font-bebas text-5xl sm:text-6xl text-[var(--color-text-main)] tracking-wide">What We Carry</h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
      {[
        { emoji: '👕', label: 'Tops & Tees'      },
        { emoji: '👖', label: 'Bottoms'           },
        { emoji: '🧥', label: 'Outerwear'         },
        { emoji: '👟', label: 'Footwear'          },
        { emoji: '🎒', label: 'Accessories'       },
        { emoji: '👗', label: 'Sets & Co-ords'    },
      ].map(({ emoji, label }) => (
        <a
          href={`${base}/shop`}
          class="group flex flex-col items-center gap-3 bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-accent)]/30 py-8 px-4 transition-all duration-300 hover:-translate-y-1"
        >
          <span class="text-3xl">{emoji}</span>
          <span class="font-barlow-condensed text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-muted)] group-hover:text-[var(--color-text-main)] transition-colors text-center">{label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ── FACEBOOK CTA ───────────────────────────────────────────── -->
  <section class="border-t border-[var(--color-border)] bg-[var(--color-bg)] py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-barlow-condensed text-xs font-semibold tracking-[0.3em] text-[var(--color-accent)] uppercase mb-4">Stay Updated</p>
      <h2 class="font-bebas text-5xl sm:text-6xl text-[var(--color-text-main)] tracking-wide mb-4">Follow Us on Facebook</h2>
      <p class="text-[var(--color-text-muted)] text-sm max-w-md mx-auto leading-relaxed mb-10">
        See our latest arrivals, store updates, and offers on our Facebook page.
        Give us a follow and never miss a new stock update.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://www.facebook.com/people/DARK-Fashion-Trends/61574476133825/"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-3 bg-[#1877F2] hover:bg-[#166fe5] text-white font-barlow-condensed font-semibold tracking-[0.15em] uppercase text-sm px-8 py-4 transition-all duration-300 hover:shadow-[0_8px_30px_rgba(24,119,242,0.4)]"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Follow on Facebook
        </a>
        <a
          href={`${base}/contact`}
          class="inline-flex items-center gap-2 border border-[var(--color-border)] hover:border-[var(--color-accent)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] font-barlow-condensed font-semibold tracking-[0.15em] uppercase text-sm px-8 py-4 transition-all duration-300"
        >
          Visit the Store
        </a>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  .text-stroke-gold {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-accent);
  }
</style>
